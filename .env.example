NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<database>?connect_timeout=30&pool_timeout=30&pgbouncer=true&sslmode=require&channel_binding=require"
# Optional for local migration/debug tooling. Vercel builds can use DATABASE_URL alone.
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
AUTH_SECRET="replace-with-a-secure-value"
CORS_ALLOW_ORIGIN="*"
NEXTAUTH_SECRET="replace-with-a-secure-value"
# AI services
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
ELEVENLABS_API_KEY=""
ELEVENLABS_SPEECH_MODEL="scribe_v2"
SOLANA_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_NETWORK="devnet"
